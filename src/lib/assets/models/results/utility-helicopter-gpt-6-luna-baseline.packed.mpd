1 1 0 20 0 0 0 1 0 1 0 -1 0 0 parts/3009.dat

0 // Blue cabin rails leave the cockpit open above the floor
1 1 -50 -4 0 1 0 0 0 1 0 0 0 1 parts/3009.dat
1 1 50 -4 0 1 0 0 0 1 0 0 0 1 parts/3009.dat
0 // White rear crossbeam joins both cabin rails
1 15 0 -28 -40 0 0 1 0 1 0 -1 0 0 parts/3009.dat

0 // Clear helicopter windscreen at the nose
